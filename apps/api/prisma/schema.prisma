generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String?
  name                String
  avatarUrl           String?
  roleId              String
  role                Role     @relation(fields: [roleId], references: [id])
  permissionOverrides UserPermission[]
  twoFactorSecret     String?
  twoFactorEnabled    Boolean  @default(false)
  googleId            String?  @unique
  refreshTokens       RefreshToken[]
  status              UserStatus @default(ACTIVE)
  assignedCreators    Creator[] @relation("CSResponsible")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id            String   @id @default(cuid())
  resource      String
  action        String
  roles         RolePermission[]
  userOverrides UserPermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

enum PermissionEffect {
  GRANT
  DENY
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect
  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum CreatorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Creator {
  id       String        @id @default(cuid())
  photoUrl String?
  name     String
  nickname String?
  status   CreatorStatus @default(ACTIVE)
  category String?
  isVip    Boolean       @default(false)
  tags     String[]      @default([])

  // contato
  phone    String?
  whatsapp String?
  email    String?
  country  String?
  language String?

  // redes sociais
  telegram  String?
  discord   String?
  instagram String?
  tiktok    String?
  youtube   String?
  kick      String?
  facebook  String?
  twitterX  String?

  // redes sociais — métricas atualizadas manualmente pelo CS (sem integração com APIs externas)
  instagramFollowers  Int?
  tiktokFollowers     Int?
  youtubeSubscribers  Int?
  telegramMembers     Int?
  socialMetricsUpdatedAt DateTime?

  // responsáveis
  csResponsibleId String?
  csResponsible   User?   @relation("CSResponsible", fields: [csResponsibleId], references: [id])
  managerId       String?

  // financeiro/documentos — armazenados criptografados (AES-256-GCM) pela camada de aplicação
  pixKey      String?
  bankName    String?
  bankAccount String?
  cpf         String?
  cnpj        String?

  notes          String?
  files          CreatorFile[]
  timelineEvents CreatorTimelineEvent[]
  deals          Deal[]
  transactions   FinanceTransaction[]
  withdrawals    WithdrawalRequest[]
  campaigns      Campaign[]
  deliveries     Delivery[]
  contracts      Contract[]
  exclusivities  Exclusivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([csResponsibleId])
}

enum FileType {
  PHOTO
  CONTRACT
  DOCUMENT
  OTHER
}

model CreatorFile {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Creator  @relation(fields: [creatorId], references: [id])
  type         FileType
  fileName     String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([creatorId])
}

model CreatorTimelineEvent {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  type        String
  description String
  actorId     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([creatorId, createdAt])
}

enum DealType {
  CPA
  REVSHARE
  HYBRID
  FEE
  MONTHLY
  WEEKLY
  BONUS
}

enum DealStatus {
  ACTIVE
  PAUSED
  ENDED
}

model Deal {
  id      String     @id @default(cuid())
  creatorId String
  creator Creator    @relation(fields: [creatorId], references: [id])
  type    DealType
  status  DealStatus @default(ACTIVE)

  // valores — armazenados em centavos para evitar problemas de arredondamento
  cpaValueCents    Int?
  revSharePercent  Float?
  fixedValueCents  Int?
  targetValueCents Int?

  startDate DateTime
  endDate   DateTime?
  autoRenew Boolean   @default(false)
  notes     String?

  transactions FinanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  TED
  BOLETO
  OTHER
}

model FinanceTransaction {
  id          String             @id @default(cuid())
  type        TransactionType
  status      TransactionStatus  @default(PENDING)
  description String
  amountCents Int
  costCenter  String?
  dueDate     DateTime
  paidAt      DateTime?
  method      PaymentMethod?
  proofFileKey String?

  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([creatorId])
  @@index([dealId])
  @@index([dueDate])
}

enum WithdrawalStatus {
  NOT_AVAILABLE
  AVAILABLE
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

// Um registro por creator por mês de competência — "Disponível para solicitar" nasce aqui
// (via job/CS marcando `availableAmountCents`) e o creator/CS avança o status até PAID.
model WithdrawalRequest {
  id                   String           @id @default(cuid())
  creatorId            String
  creator              Creator          @relation(fields: [creatorId], references: [id])
  competence           DateTime // primeiro dia do mês de competência
  availableAmountCents Int
  requestedAmountCents Int?
  requestedAt          DateTime?
  requestedById        String?
  status               WithdrawalStatus @default(NOT_AVAILABLE)
  paymentMethod        PaymentMethod?
  proofFileKey         String?
  paidAt               DateTime?
  notes                String?

  statusHistory WithdrawalStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, competence])
  @@index([status])
  @@index([competence])
}

/** Histórico de status do saque — quem alterou, quando e qual era o status anterior. */
model WithdrawalStatusHistory {
  id           String            @id @default(cuid())
  withdrawalId String
  withdrawal   WithdrawalRequest @relation(fields: [withdrawalId], references: [id])
  fromStatus   WithdrawalStatus?
  toStatus     WithdrawalStatus
  actorId      String?
  createdAt    DateTime          @default(now())

  @@index([withdrawalId, createdAt])
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  ENDED
}

model Campaign {
  id              String         @id @default(cuid())
  name            String
  objective       String?
  status          CampaignStatus @default(PLANNED)
  investmentCents Int            @default(0)
  startDate       DateTime
  endDate         DateTime?

  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id])

  // resultados — ROI/CPA/conversão são calculados sob demanda a partir destes números
  clicks        Int @default(0)
  leads         Int @default(0)
  registrations Int @default(0)
  ftds          Int @default(0)
  revenueCents  Int @default(0)

  notes      String?
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([creatorId])
}

enum DeliveryType {
  STORY
  FEED
  REELS
  VIDEO
  LIVE
  BANNER
  TELEGRAM_GROUP
  WHATSAPP_GROUP
  PUSH
  SMS
}

enum DeliveryStatus {
  PENDING
  APPROVED
  REJECTED
  CORRECTION
  PUBLISHED
  LATE
}

model Delivery {
  id         String         @id @default(cuid())
  creatorId  String
  creator    Creator        @relation(fields: [creatorId], references: [id])
  campaignId String?
  campaign   Campaign?      @relation(fields: [campaignId], references: [id])
  type       DeliveryType
  status     DeliveryStatus @default(PENDING)

  scheduledAt   DateTime // data/hora combinada com o creator
  publishedAt   DateTime?
  responsibleId String?
  fileKey       String? // upload de imagem/vídeo do criativo entregue
  comments      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([scheduledAt])
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  EXPIRED
  CANCELLED
}

// Cada upload novo do "mesmo" contrato cria uma nova linha encadeada via previousVersionId,
// em vez de sobrescrever o arquivo — dá o histórico de versões pedido no spec de graça.
model Contract {
  id                String   @id @default(cuid())
  creatorId         String
  creator           Creator  @relation(fields: [creatorId], references: [id])
  title             String
  version           Int      @default(1)
  previousVersionId String?  @unique
  previousVersion   Contract? @relation("ContractVersions", fields: [previousVersionId], references: [id])
  nextVersion       Contract? @relation("ContractVersions")

  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int

  status       ContractStatus @default(DRAFT)
  signedAt     DateTime?
  expiresAt    DateTime?
  notes        String?
  uploadedById String

  exclusivities Exclusivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
}

enum ExclusivityStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Exclusivity {
  id         String            @id @default(cuid())
  creatorId  String
  creator    Creator           @relation(fields: [creatorId], references: [id])
  company    String
  brand      String
  contractId String?
  contract   Contract?         @relation(fields: [contractId], references: [id])

  valueCents   Int
  penaltyCents Int?
  startDate    DateTime
  endDate      DateTime
  autoRenew    Boolean           @default(false)
  status       ExclusivityStatus @default(ACTIVE)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([endDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId])
}
