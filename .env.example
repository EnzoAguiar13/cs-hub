# --- Database ---
DATABASE_URL="postgresql://cshub:cshub@localhost:5432/cshub?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# AES-256-GCM key for encrypting sensitive Creator fields (cpf, cnpj, pixKey, bankAccount).
# Must be a 32-byte value, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-32-byte-base64-key"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# --- MinIO / S3-compatible storage ---
MINIO_ENDPOINT="http://localhost:9000"
MINIO_REGION="us-east-1"
MINIO_ROOT_USER="cshub"
MINIO_ROOT_PASSWORD="cshub12345"
MINIO_BUCKET="cs-hub-files"

# --- Seed ---
SEED_ADMIN_EMAIL="admin@cshub.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- App ---
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Notificações (todas opcionais — canal sem credenciais fica SKIPPED, nunca falha) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
NOTIFICATIONS_EMAIL_TO=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
